{
  "name": "webadmin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "管理端 全栈管理系统 - 一键启动后端(Spring Boot) + 前端(Vue3)",
  "scripts": {
    "dev": "node scripts/kill-ports.mjs && concurrently -n api,web,portal -c green,cyan,magenta \"pnpm dev:api\" \"pnpm dev:web\" \"pnpm dev:portal\"",
    "dev:api": "node scripts/start-api.mjs",
    "dev:web": "cd frontend && pnpm exec vite",
    "dev:portal": "cd portal && pnpm exec vite",
    "kill-ports": "node scripts/kill-ports.mjs",
    "build:web": "cd frontend && pnpm build",
    "build:api": "cd backend && mvn compile -s settings.xml -q"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}

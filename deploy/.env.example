# agent-console 环境变量模板（复制为 .env 后填写真实值；.env 不进 git）

# ── 部署模式 ─────────────────────────────────────────────────────────
# COMPOSE_PROFILES=bundled = 一键全栈：compose 额外拉起自带 MySQL 8.0 + Redis 7
#   容器，首次启动自动建库灌种子（默认账号 admin / 123456，登录后强制改密）。
# 外接自己的 MySQL/Redis（自带库用户）：
#   1. 删掉（或注释）下面 COMPOSE_PROFILES 行；
#   2. 把 AGC_MYSQL_HOST / AGC_REDIS_HOST 改回你的部署机地址；
#   3. 手动执行一次 sql/init-db.sh 初始化数据库（用法见 deploy/README.md「初始化数据库」）。
# 不设置 COMPOSE_PROFILES = 与旧版行为完全一致（只起 backend + nginx 两个容器，
# 不会创建任何数据库 / Redis 容器）。
COMPOSE_PROFILES=bundled

# ── MySQL/Redis 连接信息（backend 使用）──────────────────────────────
# bundled 模式默认指向 compose 内置服务名 mysql / redis；外接库改回部署机地址
AGC_MYSQL_HOST=mysql
AGC_MYSQL_PORT=3306
AGC_MYSQL_DB=agent-console
AGC_MYSQL_USER=agent-console
AGC_MYSQL_PASSWORD=changeme-mysql
AGC_REDIS_HOST=redis
AGC_REDIS_PORT=6379
AGC_REDIS_PASSWORD=
# Redis db 编号（默认 0；验收环境用 1）
AGC_REDIS_DATABASE=0
# Redis key 统一前缀（如 agc:dev: / agc:staging: / agc:prod:，留空不加前缀）
AGC_REDIS_KEY_PREFIX=

# ── bundled 自带 MySQL 容器（仅 COMPOSE_PROFILES=bundled 时生效）────
# root 密码仅自带容器首启建库用，与应用账号密码相互独立；必填，
# 不设置时 mysql 容器首启会报错退出。
MYSQL_ROOT_PASSWORD=changeme-root

# ── 多环境共存（同一台部署机跑多套实例时配置，单套默认不写）──────────
# 宿主端口（nginx 映射，默认 36610）
AGC_PORT=36610
# 后端镜像名（默认 agent-console-backend:latest）
AGC_IMAGE_NAME=agent-console-backend:latest
# 容器名（默认 agc-backend / agc-nginx / agc-mysql / agc-redis）
AGC_BACKEND_CONTAINER=agc-backend
AGC_NGINX_CONTAINER=agc-nginx
AGC_MYSQL_CONTAINER=agc-mysql
AGC_REDIS_CONTAINER=agc-redis
